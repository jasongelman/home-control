# Copy to server/.env and fill in real values. .env files are gitignored
# (see .gitignore); this .env.example is the only env file that should be
# tracked. Never commit real secrets — see CLAUDE.md § "Never commit secrets".

# HTTP/WebSocket port the server listens on. Defaults to 3001 if unset.
PORT=3001

# Anthropic API key for the in-app Chat Assistant. Alternatively set this
# via config.json's "anthropicApiKey" field — env var takes precedence.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Mock LEAP server ports (development only — leave unset in production).
# MOCK_PORT=3001
# MOCK_LEAP_PORT=8083
