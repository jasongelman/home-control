<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lutron Home uses your local network to discover and control Sonos speakers.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sonos._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lutron Home uses the microphone to recognize your voice commands for controlling lights and shades.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lutron Home uses speech recognition to convert your voice into commands for controlling your home.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jasongelman.LutronHome</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lutronhome</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.jasongelman.LutronHome.widgetRefresh</string>
	</array>
</dict>
</plist>
